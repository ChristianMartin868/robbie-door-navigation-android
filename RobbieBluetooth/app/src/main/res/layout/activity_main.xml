<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <EditText
        android:id="@+id/messagetextfield"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:editable="true"
        android:inputType="textMultiLine"
        android:text="Hello My Name Is ..."
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnsetspeedlr" />

    <Button
        android:id="@+id/btnfwd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="fwd"
        app:layout_constraintLeft_toRightOf="@+id/btnstop"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnstop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="stop"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnSome1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Some1"
        app:layout_constraintLeft_toRightOf="@+id/btnfwd"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BACK"
        app:layout_constraintLeft_toRightOf="@+id/btnSome1"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnrightturn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="turn right"
        app:layout_constraintLeft_toLeftOf="@+id/btnstop"
        app:layout_constraintTop_toBottomOf="@+id/btnstop" />

    <Button
        android:id="@+id/btnleftturn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="turn left"
        app:layout_constraintLeft_toRightOf="@+id/btnrightturn"
        app:layout_constraintTop_toBottomOf="@+id/btnstop" />

    <Button
        android:id="@+id/btnrighttra"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="righttra"
        app:layout_constraintLeft_toRightOf="@+id/btnleftturn"
        app:layout_constraintTop_toBottomOf="@+id/btnSome1" />

    <Button
        android:id="@+id/btnlefttra"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="lefttra"
        app:layout_constraintLeft_toRightOf="@+id/btnrighttra"
        app:layout_constraintTop_toBottomOf="@+id/btnback" />

    <SeekBar
        android:id="@+id/seekBar2"
        style="@style/Widget.AppCompat.SeekBar.Discrete"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:max="200"
        android:progress="3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnleftturn" />

    <Button
        android:id="@+id/btnsetspeedul"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:text="speed UL"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/seekBar2" />

    <Button
        android:id="@+id/btnsetspeedll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:text="Speed LL"
        app:layout_constraintStart_toEndOf="@+id/btnsetspeedul"
        app:layout_constraintTop_toBottomOf="@+id/seekBar2" />

    <Button
        android:id="@+id/btnsetspeedlr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:text="Speed LR"
        app:layout_constraintStart_toEndOf="@+id/btnsetspeedll"
        app:layout_constraintTop_toBottomOf="@+id/seekBar2" />

    <Button
        android:id="@+id/btnsetspeedur"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:text="Speed UR"
        app:layout_constraintStart_toEndOf="@+id/btnsetspeedlr"
        app:layout_constraintTop_toBottomOf="@+id/seekBar2" />

    <Button
        android:id="@+id/btnwheelaction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:text="wheel action"
        app:layout_constraintStart_toEndOf="@+id/btnsetspeedur"
        app:layout_constraintTop_toBottomOf="@+id/seekBar2" />

</android.support.constraint.ConstraintLayout>